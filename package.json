{
  "name": "axiom-:-suite-de-clarté-stratégique-ia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:backend": "cd backend && npm run dev",
    "dev:all": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\" --names \"frontend,backend\" --prefix-colors \"cyan,magenta\"",
    "build": "vite build",
    "build:frontend": "vite build",
    "build:backend": "cd backend && npm run build",
    "build:all": "npm run build:frontend && npm run build:backend",
    "preview": "vite preview",
    "start:backend": "cd backend && npm start",
    "inject-ideas": "tsx scripts/injectPublicIdeasAdmin.ts"
  },
  "dependencies": {
    "@firebase/firestore": "^4.9.2",
    "@google/genai": "^1.27.0",
    "@heroicons/react": "^2.2.0",
    "axios": "^1.13.1",
    "firebase": "^12.4.0",
    "mathjs": "^15.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "firebase-admin": "^13.5.0",
    "tsx": "^4.20.6",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
